{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smmlab",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "containers": [
    {
      "class_name": "SMMLabContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SMMLAB_CONTAINER",
        "class_name": "SMMLabContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SMMLabContainer"]
    }
  ]
}
