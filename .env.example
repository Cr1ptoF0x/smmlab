# Local Docker only: copy this file to .env and replace every placeholder.
APP_NAME="FollowBooster Store"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smmlab
DB_USERNAME=smmlab_user
DB_PASSWORD=replace-with-a-long-random-local-password

MYSQL_ROOT_PASSWORD=replace-with-another-long-random-local-password
MYSQL_DATABASE=smmlab
MYSQL_USER=smmlab_user
MYSQL_PASSWORD=replace-with-a-long-random-local-password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
